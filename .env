# ============================================================
#  Lead Automation — Environment Variables
# ============================================================

# --- Google Sheets ---
# Path to your Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/credentials.json

# The full URL or ID of your Google Sheet (default fallback)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0

# Name of the worksheet tab to use (default fallback)
GOOGLE_SHEET_WORKSHEET=Sheet1

# --- Per-offer Sheet Overrides ---
SHEET_URL_50K=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0
SHEET_WS_50K=Sheet1

SHEET_URL_BORROW_MONEY=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0
SHEET_WS_BORROW_MONEY=Sheet2

SHEET_URL_LOW_CREDIT=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0
SHEET_WS_LOW_CREDIT=Sheet3

SHEET_URL_SUPER_PERSONAL=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0
SHEET_WS_SUPER_PERSONAL=Sheet4

SHEET_URL_SIMACASH=https://docs.google.com/spreadsheets/d/1iphbGUw2z0BWy5FVmsvgq_ta9QMK8-GVazrXxK3GbFM/edit?gid=0#gid=0
SHEET_WS_SIMACASH=Sheet5

# --- Proxy Configuration ---
# Proxy source: "file" (proxies.txt), "env" (PROXY_LIST below), or "rotating" (single rotating endpoint)
PROXY_SOURCE=rotating

# If PROXY_SOURCE=env, provide comma-separated proxies here
# Format: protocol://user:pass@host:port  OR  protocol://host:port
PROXY_LIST=http://user:pass@proxy1.example.com:8080,socks5://user:pass@proxy2.example.com:1080

# If PROXY_SOURCE=rotating, provide the single rotating endpoint
# Mobile rotating proxy (froxy.com) — mobile;us geo targeting
ROTATING_PROXY_URL=http://tFxQm6EDdVq1B4d3:mobile;us;;;@proxy.froxy.com:9000
ROTATING_PROXY_MOBILE_URL=
ROTATING_PROXY_FORCE_TYPE=

# --- Playwright ---
# Run browser headless? (true / false)
HEADLESS=false

# Anthropic / OpenAI key (reserved for future CAPTCHA-solving integration)
# CAPTCHA_API_KEY=

# --- Misc ---
# Max concurrent workers (currently sequential; reserved for future use)
MAX_WORKERS=1

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO